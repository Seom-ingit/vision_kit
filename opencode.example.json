{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vision-kit": {
      "type": "local",
      "command": ["python", "-m", "vision_kit.mcp_server"],
      "enabled": true,
      "env": {
        "VISION_API_KEY": "{env:DASHSCOPE_API_KEY}",
        "VISION_API_BASE": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "VISION_MODEL": "qwen3-vl-flash"
      }
    }
  },
  "provider": {
    "dashscope": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DashScope (Alibaba Qwen)",
      "models": {
        "qwen3-vl-flash": {
          "name": "qwen3-vl-flash",
          "limit": {
            "context": 32768,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      },
      "options": {
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1"
      }
    }
  }
}
